{
  "name": "sigma-budget-data",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format:check": "prettier --check . --ignore-unknown",
    "validate:wave14": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/cli.js",
    "validate:wave14-live": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/cli.js --live --report tmp/ts-migration/candidates/14/live.json",
    "validate:wave17b": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/feed-cli.js --root packages/ingest/test/fixtures/validate17b/corpus --only FEED --report tmp/ts-migration/candidates/17b/report.json",
    "validate:wave17a": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/cli17a.js",
    "validate:wave15b": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/budget-2027-cli.js",
    "validate:wave18": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/kfp-cli.js --root packages/ingest/test/fixtures/wave18 --captures captures.json --manifest manifest.json --only KFP --report tmp/ts-migration/candidates/18/report.json",
    "validate:wave18-live": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/kfp-cli.js --root . --captures packages/ingest/test/fixtures/wave18/captures.json --manifest packages/ingest/test/fixtures/wave18/manifest.json --only KFP --report tmp/ts-migration/candidates/18/report.json",
    "validate:wave15": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/cli15.js",
    "validate:wave15-live": "pnpm --filter @sigma-budget/ingest... build && node packages/ingest/dist/validate/cli15.js --live --report tmp/ts-migration/candidates/15/live.json",
    "check:coverage": "node scripts/check-coverage.mjs",
    "format": "prettier --write . --ignore-unknown"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.8.3",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12"
  },
  "dependencies": {
    "@sigma-budget/etl": "workspace:*"
  }
}
